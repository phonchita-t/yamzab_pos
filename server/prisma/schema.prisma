// Prisma schema for Yam Zabb POS.
// Mirrors database/schema.sql. Run `npm run prisma:migrate` to apply.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CASHIER
}

enum OrderStatus {
  PENDING
  PREPARING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  QR_PROMPTPAY
  CREDIT_CARD
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  VOID
}

enum SpiceLevel {
  NONE
  MILD
  MEDIUM
  HOT
  THAI_HOT
  EXTRA_THAI_HOT
}

enum LoyaltyTxnType {
  EARN
  REDEEM
  ADJUST
  EXPIRE
}

enum StockMoveType {
  PURCHASE
  SALE
  WASTE
  ADJUSTMENT
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  fullName     String    @map("full_name")
  email        String?   @unique
  passwordHash String    @map("password_hash")
  role         UserRole  @default(CASHIER)
  pinCode      String?   @map("pin_code")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  orders               Order[]
  transactions         Transaction[]
  loyaltyTransactions  LoyaltyTransaction[]
  stockMovements       StockMovement[]

  @@map("users")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  nameTh    String?  @map("name_th")
  slug      String   @unique
  color     String   @default("#ef4444")
  icon      String?
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id             String     @id @default(uuid())
  categoryId     String     @map("category_id")
  sku            String?    @unique
  name           String
  nameTh         String?    @map("name_th")
  description    String?
  price          Decimal    @db.Decimal(10, 2)
  cost           Decimal    @default(0) @db.Decimal(10, 2)
  imageUrl       String?    @map("image_url")
  allowsSpice    Boolean    @default(false) @map("allows_spice")
  allowsPlaRa    Boolean    @default(false) @map("allows_pla_ra")
  allowsProtein  Boolean    @default(false) @map("allows_protein")
  defaultSpice   SpiceLevel @default(MEDIUM) @map("default_spice")
  isAvailable    Boolean    @default(true) @map("is_available")
  isActive       Boolean    @default(true) @map("is_active")
  trackInventory Boolean    @default(false) @map("track_inventory")
  stockQty       Decimal    @default(0) @map("stock_qty") @db.Decimal(10, 2)
  reorderLevel   Decimal    @default(0) @map("reorder_level") @db.Decimal(10, 2)
  sortOrder      Int        @default(0) @map("sort_order")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  category       Category               @relation(fields: [categoryId], references: [id])
  optionGroups   ProductOptionGroup[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@index([categoryId])
  @@map("products")
}

model OptionGroup {
  id         String  @id @default(uuid())
  name       String
  nameTh     String? @map("name_th")
  minSelect  Int     @default(0) @map("min_select")
  maxSelect  Int     @default(1) @map("max_select")
  isRequired Boolean @default(false) @map("is_required")
  sortOrder  Int     @default(0) @map("sort_order")

  options  Option[]
  products ProductOptionGroup[]

  @@map("option_groups")
}

model Option {
  id            String   @id @default(uuid())
  optionGroupId String   @map("option_group_id")
  name          String
  nameTh        String?  @map("name_th")
  priceDelta    Decimal  @default(0) @map("price_delta") @db.Decimal(10, 2)
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")

  optionGroup     OptionGroup       @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  orderItemOptions OrderItemOption[]

  @@map("options")
}

model ProductOptionGroup {
  productId     String @map("product_id")
  optionGroupId String @map("option_group_id")

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionGroup OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  @@id([productId, optionGroupId])
  @@map("product_option_groups")
}

model MembershipTier {
  id               String   @id @default(uuid())
  name             String   @unique
  minPoints        Int      @default(0) @map("min_points")
  discountPercent  Decimal  @default(0) @map("discount_percent") @db.Decimal(5, 2)
  pointsMultiplier Decimal  @default(1.0) @map("points_multiplier") @db.Decimal(4, 2)
  color            String   @default("#9ca3af")
  sortOrder        Int      @default(0) @map("sort_order")

  customers Customer[]

  @@map("membership_tiers")
}

model Customer {
  id             String   @id @default(uuid())
  phone          String   @unique
  fullName       String?  @map("full_name")
  email          String?
  birthdate      DateTime? @db.Date
  tierId         String?  @map("tier_id")
  pointsBalance  Int      @default(0) @map("points_balance")
  lifetimePoints Int      @default(0) @map("lifetime_points")
  lifetimeSpend  Decimal  @default(0) @map("lifetime_spend") @db.Decimal(12, 2)
  visitCount     Int      @default(0) @map("visit_count")
  notes          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tier                MembershipTier?      @relation(fields: [tierId], references: [id])
  orders              Order[]
  loyaltyTransactions LoyaltyTransaction[]

  @@index([phone])
  @@map("customers")
}

model LoyaltyTransaction {
  id           String         @id @default(uuid())
  customerId   String         @map("customer_id")
  orderId      String?        @map("order_id")
  type         LoyaltyTxnType
  points       Int
  balanceAfter Int            @map("balance_after")
  note         String?
  createdById  String?        @map("created_by")
  createdAt    DateTime       @default(now()) @map("created_at")

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order     Order?   @relation(fields: [orderId], references: [id])
  createdBy User?    @relation(fields: [createdById], references: [id])

  @@index([customerId])
  @@map("loyalty_transactions")
}

model LoyaltyConfig {
  id                Int      @id @default(1)
  pointsPerCurrency Decimal  @default(0.1) @map("points_per_currency") @db.Decimal(6, 3)
  currencyPerPoint  Decimal  @default(1.0) @map("currency_per_point") @db.Decimal(6, 3)
  minRedeemPoints   Int      @default(50) @map("min_redeem_points")
  maxRedeemPercent  Decimal  @default(50) @map("max_redeem_percent") @db.Decimal(5, 2)
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("loyalty_config")
}

model Order {
  id             String        @id @default(uuid())
  orderNumber    Int           @unique @default(autoincrement()) @map("order_number")
  cashierId      String        @map("cashier_id")
  customerId     String?       @map("customer_id")
  status         OrderStatus   @default(PENDING)
  orderType      String        @default("DINE_IN") @map("order_type")
  tableLabel     String?       @map("table_label")

  subtotal       Decimal       @default(0) @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(10, 2)
  tierDiscount   Decimal       @default(0) @map("tier_discount") @db.Decimal(10, 2)
  pointsRedeemed Int           @default(0) @map("points_redeemed")
  pointsValue    Decimal       @default(0) @map("points_value") @db.Decimal(10, 2)
  taxAmount      Decimal       @default(0) @map("tax_amount") @db.Decimal(10, 2)
  serviceCharge  Decimal       @default(0) @map("service_charge") @db.Decimal(10, 2)
  total          Decimal       @default(0) @db.Decimal(10, 2)
  pointsEarned   Int           @default(0) @map("points_earned")

  paymentStatus  PaymentStatus @default(PENDING) @map("payment_status")
  note           String?
  placedAt       DateTime      @default(now()) @map("placed_at")
  preparedAt     DateTime?     @map("prepared_at")
  completedAt    DateTime?     @map("completed_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  cashier             User                 @relation(fields: [cashierId], references: [id])
  customer            Customer?            @relation(fields: [customerId], references: [id])
  items               OrderItem[]
  transactions        Transaction[]
  loyaltyTransactions LoyaltyTransaction[]

  @@index([status])
  @@index([placedAt])
  @@map("orders")
}

model OrderItem {
  id            String      @id @default(uuid())
  orderId       String      @map("order_id")
  productId     String      @map("product_id")
  nameSnapshot  String      @map("name_snapshot")
  unitPrice     Decimal     @map("unit_price") @db.Decimal(10, 2)
  quantity      Int
  spiceLevel    SpiceLevel  @default(MEDIUM) @map("spice_level")
  plaRa         Boolean     @default(false) @map("pla_ra")
  optionsTotal  Decimal     @default(0) @map("options_total") @db.Decimal(10, 2)
  lineTotal     Decimal     @map("line_total") @db.Decimal(10, 2)
  note          String?
  kitchenStatus OrderStatus @default(PENDING) @map("kitchen_status")
  createdAt     DateTime    @default(now()) @map("created_at")

  order   Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product           @relation(fields: [productId], references: [id])
  options OrderItemOption[]

  @@index([orderId])
  @@map("order_items")
}

model OrderItemOption {
  id            String  @id @default(uuid())
  orderItemId   String  @map("order_item_id")
  optionId      String? @map("option_id")
  nameSnapshot  String  @map("name_snapshot")
  priceDelta    Decimal @default(0) @map("price_delta") @db.Decimal(10, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  option    Option?   @relation(fields: [optionId], references: [id])

  @@map("order_item_options")
}

model Transaction {
  id          String        @id @default(uuid())
  orderId     String        @map("order_id")
  method      PaymentMethod
  amount      Decimal       @db.Decimal(10, 2)
  tendered    Decimal?      @db.Decimal(10, 2)
  changeGiven Decimal       @default(0) @map("change_given") @db.Decimal(10, 2)
  reference   String?
  status      PaymentStatus @default(PAID)
  processedById String?     @map("processed_by")
  processedAt DateTime      @default(now()) @map("processed_at")

  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  processedBy User? @relation(fields: [processedById], references: [id])

  @@index([orderId])
  @@map("transactions")
}

model StockMovement {
  id           String        @id @default(uuid())
  productId    String        @map("product_id")
  type         StockMoveType
  quantity     Decimal       @db.Decimal(10, 2)
  balanceAfter Decimal       @map("balance_after") @db.Decimal(10, 2)
  orderId      String?       @map("order_id")
  note         String?
  createdById  String?       @map("created_by")
  createdAt    DateTime      @default(now()) @map("created_at")

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id])

  @@index([productId])
  @@map("stock_movements")
}
